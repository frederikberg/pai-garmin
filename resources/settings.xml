<settings>
    <setting propertyKey="@Properties.serverUrl" title="@Strings.ServerUrlTitle" prompt="@Strings.ServerUrlPrompt">
        <settingConfig type="alphaNumeric" />
    </setting>
    <setting propertyKey="@Properties.watchKey" title="@Strings.WatchKeyTitle" prompt="@Strings.WatchKeyPrompt">
        <settingConfig type="alphaNumeric" />
    </setting>
    <setting propertyKey="@Properties.debugLog" title="@Strings.DebugLogTitle" prompt="@Strings.DebugLogPrompt">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.micFilter" title="@Strings.MicFilterTitle" prompt="@Strings.MicFilterPrompt">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.openWith" title="@Strings.OpenWithTitle" prompt="@Strings.OpenWithPrompt">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OpenWithAuto</listEntry>
            <listEntry value="1">@Strings.OpenWithComputer</listEntry>
            <listEntry value="2">@Strings.OpenWithMenu</listEntry>
        </settingConfig>
    </setting>
</settings>
